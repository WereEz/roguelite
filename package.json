{
    "name": "roguelite",
    "version": "0.0.1",
    "description": "",
    "main": "dist/main.js",
    "scripts": {
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "build": "nest build",
        "lint": "eslint \"src/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" --fix",
        "typeorm": "typeorm-ts-node-commonjs -d src/config/DataSource.ts",
        "migration:generate": "yarn typeorm migration:generate",
        "migration:run": "yarn typeorm migration:run",
        "migration:revert": "yarn typeorm migration:revert",
        "migration:run:prod": "typeorm migration:run -d dist/config/DataSource.js",
        "docker:up": "docker compose up",
        "docker:up:build": "docker compose up --build",
        "docker:down": "docker compose down",
        "docker:logs": "docker compose logs -f app",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "^4.0.3",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "@nestjs/swagger": "^11.2.6",
        "@nestjs/typeorm": "^11.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "dotenv": "^17.3.1",
        "env-var": "^7.5.0",
        "nestjs-telegraf": "^2.9.1",
        "pg": "^8.18.0",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.0",
        "telegraf": "^4.16.3",
        "typeorm": "^0.3.28",
        "typeorm-transactional": "^0.5.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.0",
        "@types/express": "^5.0.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.0.0",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "jest": "^30.3.0",
        "jiti": "^2.6.1",
        "source-map-support": "^0.5.21",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.0"
    },
    "private": true
}
